# PostgreSQL Database Configuration
# The admin/bootstrap account is used only by the database and one-shot provisioner.
# The app container receives only the separate non-superuser PGUSER/PGPASSWORD.
# For an EXISTING volume, PGADMIN_USER/PGADMIN_PASSWORD must match its current
# POSTGRES_USER/POSTGRES_PASSWORD bootstrap credentials before first upgrade.
DATABASE_URL=
PGHOST=database
PGPORT=5432
PGDATABASE=gabah_db
PGADMIN_USER=gabah_admin
PGADMIN_PASSWORD=
PGUSER=gabah_app
PGPASSWORD=

# Optional first-account provisioning. Set unique strong values for production.
# Never commit the real .env file or paste these values into logs.
GABAH_INITIAL_ADMIN_PASSWORD=
GABAH_INITIAL_USER_PASSWORD=

# Development/UAT only: set GABAH_APP_MODE=uat and one shared test password.
# GABAH_APP_MODE defaults to production; test credentials are ignored in production mode.
GABAH_APP_MODE=production
GABAH_TEST_PASSWORD=

# Required in production: generate an independent 32+ byte secret shared by every app replica.
# Example: openssl rand -hex 32
# Development/UAT may leave this blank and use the local compatibility fallback.
GABAH_RATE_LIMIT_SECRET=

# Optional reverse proxy trust for HTTPS Origin validation.
# Comma-separated exact proxy IPs/CIDRs or loopback/linklocal/uniquelocal aliases.
# Leave blank when clients connect directly. Never use "*" or trust all proxies.
# Restrict direct access to the app port when enabling a proxy address.
GABAH_TRUST_PROXY=

# Docker image tag built by deploy.sh (record the exact release tag/SHA for production)
GABAH_IMAGE_TAG=local

# Host ports only; internal container ports stay fixed (app:3000, database:5432).
GABAH_WEB_PORT=80
GABAH_DB_PORT=5432
