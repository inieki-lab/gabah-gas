# PostgreSQL Database Configuration
# Copy to .env and set a strong, unique password before starting Docker Compose.
# PGPASSWORD is required; Docker Compose will stop with a clear error if it is empty.
# Do not commit the real .env file or production credentials.
DATABASE_URL=
PGHOST=database
PGPORT=5432
PGDATABASE=gabah_db
PGUSER=gabah_user
PGPASSWORD=

# Optional for first production provisioning. Use unique strong values.
# Never commit the real .env file or paste these values into logs.
GABAH_INITIAL_ADMIN_PASSWORD=
GABAH_INITIAL_USER_PASSWORD=
